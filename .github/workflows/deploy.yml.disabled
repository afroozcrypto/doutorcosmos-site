# Pré-visualização no GitHub Pages: https://afroozcrypto.github.io/doutorcosmos-site/
# Com noindex e robots Disallow (PUBLIC_ENV=preview), para não competir com doutorcosmos.pt.
# Workflow oficial: https://docs.astro.build/en/guides/deploy/github/
name: Deploy to GitHub Pages

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    env:
      SITE_URL: https://afroozcrypto.github.io
      BASE_PATH: /doutorcosmos-site
      PUBLIC_ENV: preview
    steps:
      - name: Checkout
        uses: actions/checkout@v7
      - name: Install, build, and upload
        uses: withastro/action@v6

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v5
