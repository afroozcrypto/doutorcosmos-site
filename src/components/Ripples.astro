---
// Ondas concêntricas: imitam as ondulações reais no gás de Perseu (NASA/CXC).
// Anéis estáticos e um só anel em movimento (transform, sem repintar).
// Para com prefers-reduced-motion.
const rings = [20, 40, 60, 80, 100];
---
<div class="frame" aria-hidden="true"><div class="ripples">
  {rings.map((s) => <span class="ring" style={`--s:${s}%`}></span>)}
  <span class="wave"></span>
  <span class="core"></span>
</div></div>
<style>
  .frame { position: absolute; inset: 0; overflow: hidden; pointer-events: none; contain: strict; }
  .ripples { position: absolute; right: -10vmin; top: 50%; width: min(90vmin, 34rem); aspect-ratio: 1; translate: 0 -50%; }
  @media (max-width: 40rem) { .ripples { right: -30vmin; top: 22%; width: 95vmin; } }
  .ring, .wave, .core { position: absolute; left: 50%; top: 50%; border-radius: 50%; translate: -50% -50%; }
  .ring { width: var(--s); height: var(--s); border: 1px solid #7cc6ff33; }
  .wave { width: 100%; height: 100%; border: 2px solid #7cc6ffaa; transform: scale(.1); opacity: 0; }
  /* Só anima em ecrãs largos: em telemóvel a animação custava desempenho (Lighthouse 88-100). */
  @media (min-width: 56rem) { .wave { animation: onda 5s cubic-bezier(.2,.6,.4,1) infinite 2.5s; } }
  .core { width: 5%; height: 5%; background: radial-gradient(circle, #fff 0 18%, #ffd166 40%, transparent 70%); }
  @keyframes onda { 0% { transform: scale(.1); opacity: .8; } 100% { transform: scale(1); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .wave { animation: none; } }
</style>
