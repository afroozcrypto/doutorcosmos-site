---
import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import Ripples from '../components/Ripples.astro';
import { SITE, publishedShorts, href } from '../lib/site';
const shorts = await publishedShorts();
// Peça de entrada: o Perseu (a única ficha publicada com "medido, traduzido, escolhido").
const entry = shorts.find((s) => s.id === 'perseus-som-buraco-negro') ?? shorts[0];
const site = new URL(href('/'), Astro.site).href;
const ld = [
  { '@type': 'WebSite', name: SITE.name, url: site, inLanguage: 'pt-PT' },
  { '@type': 'Organization', name: SITE.name, url: site, email: SITE.email, sameAs: [SITE.channel] },
];
---
<Base title="Doutor Cosmos: o universo em 30 segundos, com fontes" description="Vídeos curtos de astrofísica em português de Portugal. Cada vídeo tem uma ficha com as fontes, o que foi medido e o nível de confiança.">
  <JsonLd slot="head" data={ld} />

  <section class="hero">
    <Ripples />
    <div class="hero-text">
      <h1>O universo em 30 segundos. <span>Com fontes.</span></h1>
      <p class="lead">O Doutor Cosmos faz vídeos curtos de astrofísica em português de Portugal. Cada vídeo tem uma ficha com as fontes, o que foi medido e o nível de confiança.</p>
      <div class="actions">
        <a class="btn" href={href('/sessoes/')}>Sessão ao vivo para escolas e bibliotecas</a>
        <a class="more" href={href('/fontes/')}>Ver as fontes dos vídeos →</a>
      </div>
    </div>
  </section>

  {entry && (
    <section class="entry" aria-labelledby="entrada">
      <p class="eyebrow">Comece por aqui</p>
      <h2 id="entrada">{entry.data.headline ?? entry.data.title}</h2>
      <div class="entry-grid">
        <div>
          {entry.data.explain ? (
            <dl class="mtc">
              <div><dt>Medido</dt><dd>{entry.data.explain.measured}</dd></div>
              <div><dt>Traduzido</dt><dd>{entry.data.explain.translated}</dd></div>
              <div><dt>Escolhido</dt><dd>{entry.data.explain.chosen}</dd></div>
            </dl>
          ) : <p class="muted">{entry.data.description}</p>}
          <p><a href={href(`/fontes/${entry.id}/`)}>Ficha completa, com as fontes A e B →</a></p>
        </div>
        <div class="vid"><VideoEmbed id={entry.data.youtubeId} title={entry.data.title} /></div>
      </div>
    </section>
  )}
</Base>
<style>
  .hero { position: relative; isolation: isolate; padding: var(--s-6) 0 var(--s-5); }
  @media (min-width: 56rem) { .hero { padding: var(--s-8) 0 var(--s-7); } }
  .hero-text { position: relative; z-index: 1; max-width: 42rem; }
  .hero h1 { font-size: clamp(2.2rem, 8.5vw, 4.25rem); letter-spacing: -.03em; }
  .hero h1 span { color: var(--c-accent); }
  .lead { font-size: var(--t-lg); color: var(--c-text); max-width: 36rem; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-5); align-items: center; margin-top: var(--s-5); }
  .more { font-weight: 700; display: inline-block; padding: var(--s-2) 0; }
  .entry { margin-top: var(--s-5); }
  .entry h2 { margin-top: 0; max-width: 40rem; }
  .entry-grid { display: grid; gap: var(--s-5); align-items: start; }
  @media (min-width: 56rem) { .entry-grid { grid-template-columns: 1fr 300px; gap: var(--s-7); } }
  .vid { max-width: 240px; }
  @media (min-width: 56rem) { .vid { max-width: none; } }
  .mtc { display: grid; gap: var(--s-3); margin: 0 0 var(--s-4); }
  .mtc div { border-left: 3px solid var(--c-accent-2); padding-left: var(--s-4); }
  .mtc dt { font: 700 var(--t-sm)/1.6 var(--f-mono); text-transform: uppercase; letter-spacing: .06em; color: var(--c-accent); }
  .mtc dd { margin: 0; }
</style>
