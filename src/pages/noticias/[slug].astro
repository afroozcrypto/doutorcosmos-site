---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import { publishedPosts, publishedShorts, fmtDate, SITE, type Post, href } from '../../lib/site';
import { POST_LICENCES } from '../../lib/licences.mjs';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const shorts = await publishedShorts();
const short = shorts.find((s) => s.id === post.data.shortId);
const lic = POST_LICENCES[post.data.licence as keyof typeof POST_LICENCES];
const url = new URL(Astro.url.pathname, Astro.site).href;
const site = Astro.site!.href;
const ld = [
  {
    '@type': 'Article', headline: post.data.title, description: post.data.description, inLanguage: 'pt-PT',
    datePublished: post.data.pubDate.toISOString(), dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    mainEntityOfPage: url, image: new URL('/og.png', site).href,
    author: { '@type': 'Organization', name: SITE.name, url: site },
    publisher: { '@type': 'Organization', name: SITE.name, url: site },
  },
  {
    '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: site },
      { '@type': 'ListItem', position: 2, name: 'Notícias', item: new URL('/noticias/', site).href },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
---
<Base title={post.data.title} description={post.data.description} ogType="article">
  <JsonLd slot="head" data={ld} />
  <nav aria-label="Caminho" class="crumbs small"><a href={href('/')}>Início</a> › <a href={href('/noticias/')}>Notícias</a></nav>
  <article class="prose">
    <h1>{post.data.title}</h1>
    <p class="small muted">
      Publicado a <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
      {post.data.updatedDate && <> · atualizado a <time datetime={post.data.updatedDate.toISOString()}>{fmtDate(post.data.updatedDate)}</time></>}
    </p>
    <Content />
    <aside class="card meta">
      <h2>Fontes e licença</h2>
      {short && <p>Fontes e créditos: <a href={href(`/fontes/${short.id}/`)}>ficha do vídeo</a>.</p>}
      <p>Licença do texto: {lic.url ? <a href={lic.url} rel="license noopener">{lic.label}</a> : lic.label}.</p>
      {post.data.credit && <p>{post.data.credit}</p>}
      <h2>Como foi feito</h2>
      <p>{post.data.madeWith}</p>
      {post.data.reviewed && <p>Revisto por João Conde a <time datetime={post.data.reviewed.toISOString()}>{fmtDate(post.data.reviewed)}</time>.</p>}
      {short && <p>Vídeo: {short.data.madeWith.voice} {short.data.madeWith.images}</p>}
    </aside>
  </article>
</Base>
<style>
  .crumbs { margin-bottom: var(--s-4); color: var(--c-muted); }
  .meta { margin-top: var(--s-7); }
  .meta h2 { font-size: var(--t-lg); margin-top: 0; }
  .meta h2 + p { margin-top: 0; }
  .meta p + h2 { margin-top: var(--s-5); }
</style>
